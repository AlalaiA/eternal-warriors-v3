  for(let i=-2;i<=2;i++){ctx.fillStyle='rgb(30,40,55)';ctx.fillRect(x+i*W*0.24-4*sc,y-H*1.04,7*sc,9*sc);ctx.fillStyle='rgba(0,0,0,0.5)';ctx.fillRect(x+i*W*0.24-1.5*sc,y-H*1.03,3*sc,5*sc);}
