  for(const[px,py]of[[x-W*0.1,y-H*0.35],[x-W*0.1,y-H*0.22],[x+W*0.1,y-H*0.35],[x+W*0.1,y-H*0.22]]){ctx.fillStyle='rgb(70,55,20)';ctx.beginPath();ctx.arc(px,py,2.5*sc,0,Math.PI*2);ctx.fill();}
